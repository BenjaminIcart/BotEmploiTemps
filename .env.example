# Lien .ics de ton emploi du temps (secret !)
ICS_URL=https://...

# Webhook Discord : Salon > Modifier > Intégrations > Webhooks > Nouveau > Copier l'URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Clé API PRIM (https://prim.iledefrance-mobilites.fr) -> abonne-toi à
# "Calculateur Île-de-France Mobilités - Accès générique (v2)"
PRIM_API_KEY=

# Minutes entre chez toi et le quai (trajet + marge)
ACCESS_COIGNIERES=18
ACCESS_TRAPPES=22
WALK_SCHOOL=15
MARGIN=5
DELAY_ALERT=3
RECAP_HOUR=20:00
WEB_PORT=8080

# Optionnel
# WEB_TOKEN=un_mot_de_passe        -> http://IP:8080/?token=un_mot_de_passe
# HA_WEBHOOK_URL=http://IP_HA:8123/api/webhook/train_retard
# Forcer les ID de gare si la détection auto se trompe (voir les logs) :
# STOP_COIGNIERES=stop_area:IDFM:xxxxx
# STOP_TRAPPES=stop_area:IDFM:xxxxx
# STOP_MONTPARNASSE=stop_area:IDFM:xxxxx
